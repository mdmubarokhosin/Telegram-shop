# .env.example
# সতর্কতা: রিয়েল ক্রেডেনশিয়াল কখনো গিটে কমিট করবেন না!
# এই ফাইলকে .env নামে কপি করে আপনার তথ্য দিন

# === TELEGRAM কনফিগারেশন ===
# @BotFather থেকে নিন
TOKEN=your_bot_token_here
# আপনার Telegram User ID (@userinfobot থেকে নিন)
OWNER_ID=1779607726

# === BOHUDUR পেমেন্ট ===
# https://console.bohudur.one থেকে নিন (Google দিয়ে লগইন)
BOHUDUR_API_KEY=your_bohudur_api_key_here
# ঐচ্ছিক: অটোমেটিক পেমেন্ট কনফার্মেশনের জন্য
# উদাহরণ: https://your-domain.com/bohudur/webhook
BOHUDUR_WEBHOOK_URL=

# === পেমেন্ট সেটিংস ===
# মুদ্রা (বাংলাদেশের জন্য BDT)
PAY_CURRENCY=BDT
# রেফারেল বোনাস শতাংশ (0-100, 0 = বন্ধ)
REFERRAL_PERCENT=0
# পেমেন্ট টাইমআউট (সেকেন্ডে)
PAYMENT_TIME=1800
# পেমেন্ট সীমা
MIN_AMOUNT=10
MAX_AMOUNT=50000

# === লিংক ও UI ===
CHANNEL_URL=
CHANNEL_ID=
HELPER_ID=
RULES=

# === ভাষা ও লগিং ===
# ভাষা: bn (বাংলা), en (English), ru (Русский)
BOT_LOCALE=bn
BOT_LOGFILE=logs/bot.log
BOT_AUDITFILE=logs/audit.log
LOG_TO_STDOUT=1
LOG_TO_FILE=1
DEBUG=0
REVIEWS_ENABLED=1

# === REDIS (ডিফল্ট বন্ধ) ===
REDIS_ENABLED=0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# === ডাটাবেস ===
# Termux/লোকাল: sqlite+aiosqlite
# প্রোডাকশন/Cloudflare: postgresql+asyncpg
DB_DRIVER=sqlite+aiosqlite
SQLITE_DB_PATH=data/shop.db

# PostgreSQL (শুধুমাত্র প্রোডাকশনে)
POSTGRES_DB=telegram_shop
POSTGRES_USER=shop_user
POSTGRES_PASSWORD=change_me_to_strong_password
POSTGRES_HOST=localhost
DB_PORT=5432

# === অ্যাডমিন প্যানেল ===
ADMIN_HOST=localhost
ADMIN_PORT=9090
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
SECRET_KEY=change-me-in-production

# === ওয়েবহুক (ঐচ্ছিক) ===
WEBHOOK_ENABLED=0
WEBHOOK_URL=
WEBHOOK_PATH=/webhook
WEBHOOK_SECRET=

# === অটো-ক্লিনআপ ===
AUDIT_RETENTION_DAYS=90
PAYMENTS_RETENTION_DAYS=90